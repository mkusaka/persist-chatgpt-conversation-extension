{
  "name": "persist-chatgpt-conversation-extension",
  "version": "0.0.1",
  "packageManager": "pnpm@10.19.0",
  "description": "Persist ChatGPT conversations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkusaka/persist-chatgpt-conversasion-extension.git"
  },
  "scripts": {
    "build": "run-p build:*",
    "watch": "run-p watch:*",
    "build:background": "esbuild background.ts --bundle --target=chrome100 --outfile=background.js",
    "watch:background": "esbuild background.ts --bundle --target=chrome100 --watch --outfile=background.js",
    "build:content": "esbuild content.ts --bundle --target=chrome100 --outfile=content.js",
    "watch:content": "esbuild content.ts --bundle --target=chrome100 --watch --outfile=content.js",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "rm -f package.zip && pnpm build && zip -r package.zip . -x '.git/**' './node_modules/**' 'pnpm*' '*.ts' '.idea/**' 'tsconfig.json' 'package.json' '.gitignore' '.oxfmtrc.json'"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.2",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.19.0",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  }
}
