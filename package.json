{
  "name": "persist-chatgpt-conversation-extension",
  "version": "0.0.3",
  "packageManager": "pnpm@10.19.0",
  "description": "Persist ChatGPT conversations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkusaka/persist-chatgpt-conversasion-extension.git"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint . --import-plugin --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint . --import-plugin --tsconfig ./tsconfig.json --fix",
    "lint:ci": "oxlint . --import-plugin --tsconfig ./tsconfig.json --deny-warnings",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "package": "rm -f package.zip && pnpm build && cd dist && zip -r ../package.zip ."
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.2.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/user-event": "14.6.1",
    "@types/chrome": "0.1.32",
    "@vitest/ui": "3.2.4",
    "@webext-core/fake-browser": "1.3.4",
    "happy-dom": "18.0.1",
    "oxlint": "1.18.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
