{
  "name": "persist-chatgpt-conversation-extension",
  "version": "0.0.4",
  "packageManager": "pnpm@11.20.0",
  "description": "Persist ChatGPT conversations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mkusaka/persist-chatgpt-conversasion-extension.git"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint . --import-plugin --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint . --import-plugin --tsconfig ./tsconfig.json --fix",
    "lint:ci": "oxlint . --import-plugin --tsconfig ./tsconfig.json --deny-warnings",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "package": "rm -f package.zip && pnpm build && cd dist && zip -r ../package.zip ."
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.4.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/user-event": "14.6.1",
    "@types/chrome": "0.1.43",
    "@vitest/ui": "4.1.8",
    "@webext-core/fake-browser": "2.0.1",
    "happy-dom": "20.10.2",
    "oxlint": "1.68.0",
    "prettier": "3.8.3",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
